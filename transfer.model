# Category-Partition constraints for the bank transfer function.
# Errors are tested one at a time. Currency conversion is a SINGLE positive
# scenario and is therefore included only in the valid happy-path class.
From:     Valid, Frozen, Missing
To:       Valid, Missing, SameAsFrom
Amount:   Zero, Normal, OverBalance, OverLimit
Currency: Same, Different

# [ERROR] source-account cases: a single source error, normal target and amount.
IF [From] IN {"Frozen", "Missing"}
THEN [To] = "Valid" AND [Amount] = "Normal" AND [Currency] = "Same";

# [ERROR] destination-account cases: source is valid, one destination error only.
IF [To] IN {"Missing", "SameAsFrom"}
THEN [From] = "Valid" AND [Amount] = "Normal" AND [Currency] = "Same";

# [ERROR] amount cases: both accounts valid, only one amount error.
IF [Amount] IN {"Zero", "OverBalance", "OverLimit"}
THEN [From] = "Valid" AND [To] = "Valid" AND [Currency] = "Same";
